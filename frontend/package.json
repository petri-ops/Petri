{
  "name": "biof3-desktop-frontend",
  "version": "0.0.1-rc.4",
  "private": true,
  "description": "BioF3 桌面版原生前端 — Vite SPA（脱离 Docusaurus）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'),p=require('path'),d='dist/exports';if(fs.existsSync(d))for(const e of fs.readdirSync(d))if(e!=='figcode')fs.rmSync(p.join(d,e),{recursive:true,force:true})\"",
    "build:check": "tsc -b && vite build && node -e \"const fs=require('fs'),p=require('path'),d='dist/exports';if(fs.existsSync(d))for(const e of fs.readdirSync(d))if(e!=='figcode')fs.rmSync(p.join(d,e),{recursive:true,force:true})\"",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "infima": "^0.2.0-alpha.45",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-admonitions": "^1.2.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@docusaurus/tsconfig": "^3.10.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^14.0.0",
    "remark-frontmatter": "^5.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
