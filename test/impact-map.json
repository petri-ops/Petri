    {"id":"p6-service-recovery-pressure-fixture","note":"The non-qualifying P6-1a synthetic service fixture and its optional checkpoint select source binding, runtime-lease, exact-cohort, lifecycle, background-process and public redaction regressions; this rule does not represent full P6 product acceptance.","patterns":["scripts/g0-rs-p6-recovery-acceptance.mjs","acceptance/g0-result-studio/rs-p6-service-recovery-pressure-checkpoint.json"],"tests":["test/g0-rs-p6-recovery-acceptance.test.mjs","test/result-changeset-service.test.mjs","test/result-studio-lifecycle.test.mjs","test/result-studio-background.test.mjs","test/result-studio-route-baseline.test.mjs"],"classifiesScripts":false},
