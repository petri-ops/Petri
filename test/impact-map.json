{
  "schema": "biof3/test-impact-map.v1",
  "description": "Fail-closed mapping from changed workspace paths to the smallest sufficient test and governance scope.",
  "rules": [
    {"id":"governance-docs","patterns":["AGENTS.md","CLAUDE.md","frontend/AGENTS.md","docs/**",".agents/**"],"commands":["docs-check"],"classifiesScripts":false},
    {"id":"ui-ledger","patterns":["docs/ui-productization-audit.md"],"commands":["ui-audit"],"classifiesScripts":false},
    {"id":"frontend-source","patterns":["frontend/src/**"],"commands":["ui-audit","frontend-check"],"frontendRelated":true,"classifiesScripts":false},
    {"id":"frontend-config","patterns":["frontend/package.json","frontend/package-lock.json","frontend/vite.config.*","frontend/tsconfig*.json"],"commands":["frontend-check","frontend-all"],"classifiesScripts":false},
    {"id":"git-backend","note":"Git backend changes run lifecycle/repository tests; the now-green P4R source/replay invariant is selected by Result Studio production paths rather than every low-level adapter edit.","patterns":["core/shared-backend/git-adapter.js","core/shared-backend/git-repository-binding.js"],"tests":["test/git-adapter.test.mjs","test/result-studio-lifecycle.test.mjs","test/result-studio-repository.test.mjs"],"classifiesScripts":false},
    {"id":"result-studio","note":"P4R source projection, controlled replay, background materialization and Code tests are owned by P4R; the explicit invariant gates remain listed so a route regression cannot be hidden by the default bundle.","patterns":["core/shared-backend/result-*.js","core/r-server/routes/result-studio.js","core/r-server/agent-tools/result-*.js","frontend/src/components/result-studio/**","frontend/src/lib/result-studio-*.ts","frontend/src/lib/result-edit-agent-bridge.ts","frontend/src/lib/artifact-selection.ts","frontend/src/components/result-studio/resultBodyState.ts"],"tests":["test/result-edit-controls.test.mjs","test/result-edit-intent.test.mjs","test/result-edit-agent-tool.test.mjs","test/result-studio-agent-binding.test.mjs","test/result-studio-context.test.mjs","test/result-studio-contracts.test.mjs","test/result-studio-repository.test.mjs","test/result-studio-background.test.mjs","test/result-changeset-service.test.mjs","test/result-revision-source.test.mjs","test/result-replay-service.test.mjs","test/p4r-invariants.test.mjs","test/result-compare-service.test.mjs","test/result-studio-lifecycle.test.mjs","test/result-studio-plugin-sdk.test.mjs","test/result-studio-qualification.test.mjs","test/result-studio-table-query.test.mjs","test/result-selection-tools.test.mjs","test/artifact-interaction.test.mjs","test/agent-tool-registry.test.mjs"],"classifiesScripts":false},
    {"id":"agent-tool-interceptor","patterns":["core/r-server/agent-tools/agent-tool-interceptor.js"],"tests":["test/agent-tool-policy.test.mjs","test/result-studio-agent-binding.test.mjs"],"classifiesScripts":false},
    {"id":"result-studio-agent-runtime","patterns":["core/r-server/agent-runner.js","core/r-server/routes/ai-agent.js","core/r-server/helpers/system-prompt.js"],"tests":["test/result-studio-agent-binding.test.mjs","test/system-prompt-result-context.test.mjs"],"classifiesScripts":false},
    {"id":"loop","patterns":["core/shared-backend/loop-*.js","core/r-server/agent-runner.js","core/r-server/routes/ai-loop.js","core/r-server/routes/loop.js"],"tests":["test/loop-contract.test.mjs","test/loop-repository.test.mjs","test/loop-controller.test.mjs","test/loop-controller-integration.test.mjs","test/loop-validator-registry.test.mjs","test/loop-validators.test.cjs","test/loop-failure-diagnoser.test.cjs","test/loop-repair-strategy.test.cjs","test/loop-checkpoint.test.cjs","test/loop-agent-integration.test.mjs","test/loop-false-success-regression.test.mjs","test/loop-recovery-integration.test.mjs","test/loop-durable-resume.test.mjs","test/loop-api-route.test.mjs"],"classifiesScripts":false},
    {"id":"scientific-task","patterns":["core/shared-backend/scientific-*.js","core/shared-backend/delivery-manifest.js","core/shared-backend/execution-provenance.js","core/shared-backend/artifact-manifest.js","core/shared-backend/artifact-profiles.js","core/shared-backend/agent-workflow.js","test/fixtures/harness-scientific-task/**"],"tests":["test/scientific-task-spec.test.mjs","test/scientific-task-planner.test.mjs","test/scientific-task-confirmation.test.mjs","test/scientific-task-persistence.test.mjs","test/execution-provenance.test.mjs","test/delivery-manifest.test.mjs","test/scientific-replay-package.test.mjs","test/agent-workflow.test.mjs","test/harness-workflow-fixtures.test.mjs","test/g0-sdc0-profile-registry.test.mjs"],"classifiesScripts":false},
    {"id":"g0-baseline","patterns":["core/shared-backend/g0-*.js","core/shared-backend/g0/**","test/g0-*.test.mjs","test/fixtures/g0-**/**"],"tests":["test/g0-baseline.test.mjs","test/g0-project-baseline.test.mjs","test/g0-api-route.test.mjs","test/g0-first-wave.test.mjs","test/g0-second-wave.test.mjs","test/g0-third-wave.test.mjs","test/g0-fourth-wave.test.mjs","test/g0-fifth-wave.test.mjs","test/g0-baseline-qualification.test.mjs","test/g0-qualification-gate.test.mjs"],"classifiesScripts":false},
    {"id":"provider","patterns":["core/shared-backend/llm-*.js","core/shared-backend/model-*.js","core/shared-backend/llm-providers/**","core/r-server/agent-tools/vision-tools.js"],"tests":["test/model-gateway.test.mjs","test/model-profile.test.mjs","test/provider-protocol.test.mjs","test/provider-streaming.test.mjs","test/anthropic-provider.test.mjs","test/harness-provider-eval.test.mjs","test/agent-provider-boundary.test.mjs"],"classifiesScripts":false},
    {"id":"chf0-critical","patterns":["src/main.js","core/py-server/routes/raw-execution.js","core/r-server/helpers/process-lifecycle.js","core/r-server/helpers/tools-executor.js","core/r-server/routes/files.js","core/r-server/routes/r-compute.js","core/r-server/routes/tools-platform.js","core/shared-backend/local-request-boundary.js","resources/built-in-plugins/pca-explorer/**","resources/built-in-plugins/volcano-plot/**"],"tests":["test/g0-chf0-http.test.mjs","test/g0-chf0-science.test.mjs","test/g0-chf0-lifecycle.test.mjs"],"classifiesScripts":false},
    {"id":"plugin-runtime","patterns":["resources/built-in-plugins/**","core/r-server/plugin-loader.js","core/r-server/mcp/**","core/r-server/tool-registry.js","core/r-server/tool-scripts/**","src/plugin-manager.js"],"tests":["test/plugin-sdk.test.mjs","test/plugin-manifest-schema.test.mjs","test/plugin-loader-refresh.test.mjs","test/capability-bundles.test.mjs","test/capability-bundle-wiring.test.mjs","test/capability-provisioning.test.mjs","test/mcp-plugin-autoload.test.mjs","test/mcp-builtin-discovery.test.mjs","test/mcp-tool-registry.test.mjs","test/harness-manifest.test.mjs","test/harness-tool-template.test.mjs"],"classifiesScripts":false},
    {"id":"electron-runtime","patterns":["src/**","build/**","core/r-server/db.js","src/migrations/**","electron-builder.yml"],"tests":["test/mcp-server.test.mjs","test/mcp-server-autoload.test.mjs","test/mcp-bin-e2e.test.mjs","test/mcp-tool-registry.test.mjs","test/platform-compat.test.mjs","test/migration-runner.test.mjs","test/backend-health.test.mjs","test/credential-store.test.mjs"],"classifiesScripts":false},
    {"id":"backend-fallback","patterns":["core/r-server/**","core/py-server/**","core/packages/**","core/shared-backend/storage/**","core/shared-backend/path-safe.js","core/shared-backend/local-request-boundary.js"],"tests":["test/backend-health.test.mjs","test/tools-input-validation.test.mjs","test/tools-executor-job-context.test.mjs","test/artifact-truth.test.mjs","test/project-sandbox-compat.test.mjs","test/project-sandbox-artifacts.test.mjs"],"classifiesScripts":false},
    {"id":"release-contract","patterns":["release-contract.json","release/**","scripts/build-r-bundle.mjs","scripts/fix-r-paths.*","scripts/install-core-deps.mjs","scripts/publish-*.mjs","scripts/publish-*.sh","scripts/release-*.mjs","scripts/validate-runtime-first-use.cjs"],"tests":["test/release-contract.test.mjs","test/oss-auto-update.test.mjs","test/macos-oss-updater.test.mjs","test/capability-bundles.test.mjs"],"classifiesScripts":true,"scriptRole":"release-runtime"},
    {"id":"script-result-current","patterns":["scripts/g0-rs-p*.mjs","scripts/g0-rs-p*.cjs"],"tests":["test/result-studio-qualification.test.mjs","test/result-studio-context.test.mjs","test/agent-tool-registry.test.mjs"],"classifiesScripts":true,"scriptRole":"current-result-studio"},
    {"id":"script-result-historical","patterns":["scripts/g0-rs6-*","scripts/g0-rs7-*","scripts/g0-rs8-*","scripts/g0-rs9-*"],"tests":["test/result-studio-qualification.test.mjs"],"classifiesScripts":true,"scriptRole":"historical-result-studio"},
    {"id":"script-g0-maintained","patterns":["scripts/g0-start-*","scripts/g0-lf0-*","scripts/g0-first-*","scripts/g0-second-*","scripts/g0-third-*","scripts/g0-fourth-*","scripts/g0-fifth-*","scripts/g0-qualification-*","scripts/g0-sdc0-*"],"tests":["test/g0-baseline.test.mjs","test/g0-baseline-qualification.test.mjs","test/g0-qualification-gate.test.mjs"],"classifiesScripts":true,"scriptRole":"maintained-g0"},
    {"id":"script-harness","patterns":["scripts/harness-*.mjs","scripts/plugin-contract-lint.js","scripts/scaffold-harness-tool.mjs"],"tests":["test/harness-manifest.test.mjs","test/harness-tool-template.test.mjs","test/agent-workflow.test.mjs","test/harness-workflow-fixtures.test.mjs"],"classifiesScripts":true,"scriptRole":"harness"},
    {"id":"script-governance","patterns":["scripts/docs-governance.mjs","scripts/check-*.mjs","scripts/test-affected.mjs"],"tests":["test/docs-governance.test.mjs","test/test-affected.test.mjs"],"classifiesScripts":true,"scriptRole":"governance"},
    {"id":"script-dev-and-smoke","patterns":["scripts/dev-*.js","scripts/dev-*.sh","scripts/qa-smoke.mjs","scripts/golden-path.mjs"],"tests":["test/qa-smoke.test.mjs","test/run-json.test.mjs","test/backend-health.test.mjs"],"classifiesScripts":true,"scriptRole":"development-smoke"},
    {"id":"perf-probe","patterns":["core/r-server/helpers/perf-probe.js","core/r-server/routes/perf-probe.js","core/r-server/bootstrap.js","core/r-server/server.js"],"tests":["test/perf-probe.test.mjs","test/backend-health.test.mjs","test/p4r-capture.test.mjs"],"classifiesScripts":false},
    {"id":"p4r-capture","note":"The P4R capture, live journey and renderer producers also match script-result-current, which classifies them. This rule adds their real harness tests so evidence drift cannot hide behind qualification-only checks.","patterns":["scripts/g0-rs-p4r-capture.mjs","scripts/g0-rs-p4r-corpus.mjs","scripts/g0-rs-p4r-baseline.mjs","scripts/g0-rs-p4r-acceptance.mjs","scripts/g0-rs-p4r-product-acceptance.mjs","scripts/g0-rs-p4r-source-observation.mjs","scripts/g0-rs-p4r-live-observation.mjs","scripts/g0-rs-p4r-ui-observation.mjs","scripts/g0-rs-p4r-ui-driver.cjs"],"tests":["test/p4r-capture.test.mjs","test/p4r-corpus.test.mjs","test/p4r-baseline.test.mjs","test/p4r-live-observation.test.mjs","test/p4r-ui-observation.test.mjs","test/perf-probe.test.mjs","test/result-revision-source.test.mjs","test/result-replay-service.test.mjs"],"classifiesScripts":false},
    {"id":"p5-real-scientific-editing","note":"The P5 producer and its source-bound evidence must select the complete focused scientific-editing contract bundle. The producer already has one script classification through script-result-current; this rule adds its direct verifier and every P5 Truth, validator, cohort, replay and scientific-diff regression.","patterns":["scripts/g0-rs-p5-acceptance.mjs","acceptance/g0-result-studio/rs-p5-scientific-editing.json"],"tests":["test/g0-rs-p5-acceptance.test.mjs","test/agent-run-tool.test.mjs","test/agent-tool-registry.test.mjs","test/artifact-truth.test.mjs","test/execution-provenance.test.mjs","test/git-adapter.test.mjs","test/result-changeset-service.test.mjs","test/result-compare-service.test.mjs","test/result-edit-agent-tool.test.mjs","test/result-edit-controls.test.mjs","test/result-edit-intent.test.mjs","test/result-plugin-validator.test.mjs","test/result-replay-service.test.mjs","test/result-revision-replay-package.test.mjs","test/result-revision-source.test.mjs","test/result-scientific-compare.test.mjs","test/result-scientific-rerun.test.mjs","test/result-selection-tools.test.mjs","test/result-studio-context.test.mjs","test/result-studio-lifecycle.test.mjs","test/result-studio-migration.test.mjs","test/result-studio-plugin-sdk.test.mjs","test/result-studio-repository.test.mjs","test/result-workflow-graph.test.mjs","test/scientific-replay-package.test.mjs","test/test-affected.test.mjs","test/tools-executor-job-context.test.mjs","test/tools-input-validation.test.mjs"],"classifiesScripts":false},
    {"id":"acceptance-result-studio","patterns":["acceptance/g0-result-studio/**"],"tests":["test/result-studio-qualification.test.mjs"],"classifiesScripts":false},
    {"id":"acceptance-harness-loop","patterns":["acceptance/harness-loop/**"],"tests":["test/loop-fixtures.test.mjs","test/loop-spt1-acceptance.test.mjs"],"classifiesScripts":false},
    {"id":"acceptance-script-owned","note":"Evidence trees with no Node test reader. Their owning npm gate regenerates and verifies them, so changing the stored evidence selects no test. Listed explicitly so a new acceptance/<tree> stays unmapped and fails closed until its verification owner is declared.","patterns":["acceptance/g0-living-foundation/**","acceptance/g0-qualification/**","acceptance/g0-scientific-data-contract/**","acceptance/harness-phase7/**","acceptance/harness-plugin-prototype/**","acceptance/harness-plugins/**","acceptance/harness-scientific-task/**","acceptance/ui-032/**","acceptance/ui-034/**"],"classifiesScripts":false},
    {"id":"acceptance-chf0","patterns":["acceptance/g0-critical-crosscut-hardening/**","scripts/g0-chf0-acceptance.mjs"],"tests":["test/g0-chf0-http.test.mjs","test/g0-chf0-science.test.mjs","test/g0-chf0-lifecycle.test.mjs"],"classifiesScripts":true,"scriptRole":"critical-crosscut-hardening"},
    {"id":"test-infrastructure","patterns":["test/**","test/impact-map.json"],"tests":["test/test-affected.test.mjs"],"classifiesScripts":false},
    {"id":"metadata-config","patterns":["package.json","package-lock.json","tsconfig*.json",".github/**","CHANGELOG.md"],"commands":["docs-check"],"tests":["test/test-affected.test.mjs"],"classifiesScripts":false}
  ]
}
