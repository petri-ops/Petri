    {"id":"acceptance-script-owned","note":"Evidence trees with no Node test reader. Their owning npm gate regenerates and verifies them, so changing the stored evidence selects no test. Listed explicitly so a new acceptance/<tree> stays unmapped and fails closed until its verification owner is declared.","patterns":["acceptance/g0-living-foundation/**","acceptance/g0-qualification/**","acceptance/g0-scientific-data-contract/**","acceptance/harness-phase7/**","acceptance/harness-plugin-prototype/**","acceptance/harness-plugins/**","acceptance/harness-scientific-task/**","acceptance/ui-032/**","acceptance/ui-034/**","acceptance/MODEL-ANTHROPIC-NATIVE/**","acceptance/ui-199/**","acceptance/ui-128/**","acceptance/ui-127/**","acceptance/ui-126/**","acceptance/ui-111/**","acceptance/ui-109/**","acceptance/ui-108/**","acceptance/ui-103/**","acceptance/ui-052/**","acceptance/ui-044/**","acceptance/ui-042/**","acceptance/ui-041/**","acceptance/ui-040/**","acceptance/ui-039/**","acceptance/ui-038/**","acceptance/ui-037/**","acceptance/ui-036/**","acceptance/startup-runtime/**","acceptance/agent-concurrency/**"],"classifiesScripts":false},
