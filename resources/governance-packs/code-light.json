{
  "id": "code-light",
  "version": 1,
  "title": "普通代码仓（仅 git，无治理台账）",
  "priority": 10,
  "detect": {
    "all": [
      { "gitRepo": true },
      { "not": { "pathExists": "docs/DOC-REGISTRY.json" } }
    ]
  },
  "rules": [
    {
      "id": "checkpoint-before-change",
      "kind": "mechanical",
      "statement": "大改前先形成可回退的 checkpoint（提交或快照），工作区不干净时先说明。",
      "origin": "authored"
    },
    {
      "id": "tests-green-before-done",
      "kind": "mechanical",
      "statement": "声称完成前，该仓库已有的测试命令必须跑绿；没有测试就如实说明未验证。",
      "origin": "authored"
    },
    {
      "id": "minimal-diff",
      "kind": "judgment",
      "statement": "最小改动优先；重构与功能改动分开提交，便于回滚与评审。",
      "origin": "authored"
    }
  ]
}
