{
  "id": "gsea",
  "pluginManifestVersion": 1,
  "title": "GSEA 基因集富集分析",
  "version": "1.0.0",
  "language": "r",
  "description": "Gene Set Enrichment Analysis（GSEA）：基于全基因组排序的基因集富集（clusterProfiler gseGO/gseKEGG/Hallmark），无需预设显著阈值，支持基因排序列表或 DESeq2 差异结果输入。",
  "requiresBundle": "r-enrichment",
  "requiresBundleVersion": "1.0.0",
  "packages": {
    "r": {
      "clusterProfiler": ">=4.16.0",
      "enrichplot": ">=1.28.0",
      "DOSE": ">=3.30.0",
      "org.Hs.eg.db": ">=3.19.0",
      "org.Mm.eg.db": ">=3.19.0",
      "msigdbr": ">=7.5.0",
      "ggplot2": ">=3.5.0",
      "jsonlite": ">=1.8.0",
      "base64enc": ">=0.1-3"
    }
  },
  "runtime": {
    "r": ">=4.4.0"
  },
  "builtAgainst": {
    "r": "4.5"
  },
  "platform": ["macos-arm64"],
  "supportedPlatforms": ["macos-arm64"]
}
