{
  "id": "volcano-plot",
  "title": "火山图绘制",
  "subtitle": "差异基因可视化",
  "category": "bulk RNA-seq",
  "language": "r",
  "description": "从差异分析结果绘制火山图",
  "inputs": [
    {
      "id": "deg_table",
      "label": "差异分析结果表 (CSV: gene, log2FoldChange|log2FC, pvalue[, padj])",
      "type": "file",
      "required": true,
      "accept": ".csv"
    },
    {
      "id": "lfc_col",
      "label": "LFC 列名",
      "type": "text",
      "required": false,
      "hint": "log2FoldChange 列名。默认自动探测：优先 log2FoldChange（canonical），fallback log2FC（DESeq2 直接输出）",
      "default": null
    },
    {
      "id": "gene_col",
      "label": "gene ID 列名",
      "type": "text",
      "required": false,
      "default": "gene"
    },
    {
      "id": "pval_col",
      "label": "pvalue 列名",
      "type": "text",
      "required": false,
      "default": "pvalue"
    },
    {
      "id": "fc_threshold",
      "label": "|log2FC| 阈值",
      "type": "number",
      "default": 1,
      "hint": "差异基因判定阈值，默认 1（即 2 倍变化）"
    },
    {
      "id": "pval_threshold",
      "label": "p value 阈值 (-log10)",
      "type": "number",
      "default": 1.3,
      "hint": "默认 1.3 即 p < 0.05"
    },
    {
      "id": "top_n",
      "label": "标注 top N 基因",
      "type": "number",
      "default": 10,
      "hint": "在图上标注变化最显著的 N 个基因名"
    }
  ],
  "outputs": [
    {
      "id": "volcano",
      "type": "plot",
      "label": "火山图"
    },
    {
      "id": "classified_table",
      "type": "table",
      "label": "分类结果表"
    }
  ],
  "resultStudio": {
    "contractVersion": 1,
    "descriptorVersion": 1,
    "semanticType": "differential_expression_volcano",
    "entity": { "type": "classified_gene", "idField": "gene", "fields": { "gene": "string", "log2FoldChange": "number", "pvalue": "number", "classification": "string" } },
    "source": { "strategy": "execution_snapshot_per_artifact", "entryPoint": "scripts/volcano-plot.R" },
    "independentScriptPathTemplate": "analysis/scripts/{artifactFamilyId}/{revisionId}/{artifactId}.R",
    "inputBindings": [{ "inputId": "deg_table", "required": true, "acceptsArtifactTypes": ["table"], "semanticRole": "differential_expression_table" }],
    "parameters": {
      "lfc_col": { "type": "text", "default": null },
      "gene_col": { "type": "text", "default": "gene" },
      "pval_col": { "type": "text", "default": "pvalue" },
      "fc_threshold": { "type": "number", "default": 1, "minimum": 0 },
      "pval_threshold": { "type": "number", "default": 1.3, "minimum": 0 },
      "top_n": { "type": "number", "default": 10, "minimum": 0 }
    },
    "parameterImpacts": { "lfc_col": "data", "gene_col": "data", "pval_col": "data", "fc_threshold": "scientific", "pval_threshold": "scientific", "top_n": "data" },
    "actions": ["select_genes", "classify_rows", "recompute"],
    "artifacts": [
      { "id": "volcano", "type": "plot", "filename": "volcano.png" },
      { "id": "classified_table", "type": "table", "filename": "classified_table.csv" }
    ],
    "validator": { "id": "volcano_result_truth_v1", "checks": ["artifact_truth_valid", "script_sha256", "input_sha256", "output_sha256", "finite_statistics"] },
    "goldenFixture": { "path": "golden-revisions/result-studio-v1.json" },
    "upgradePolicy": { "sameMajor": "compatible_if_contract_digests_match", "contractDrift": "migration_required", "missingMigration": "read_only_legacy" }
  },
  "failureModes": [
    {
      "code": "missing_required_file_inputs",
      "title": "缺少必需输入文件",
      "description": "火山图至少需要差异分析结果表；没有该表就无法继续。",
      "recoverable": true,
      "suggestedFix": "让 Harness 自动从项目中选择差异结果表，或手动补充输入文件。",
      "detect": "missing required file inputs|missing input file|please provide file"
    },
    {
      "code": "missing_required_columns",
      "title": "缺少必需列",
      "description": "输入 CSV 必须包含 gene、log2FC、pvalue 三列或可被后续探测层映射的等价列。",
      "recoverable": true,
      "suggestedFix": "探测表头并尝试把 symbol/gene_name 映射为 gene，把 logFC/avg_log2FC 映射为 log2FC，把 p_val/padj 映射为 pvalue。",
      "detect": "missing required columns|LFC 列|log2FoldChange|log2FC|实际列名"
    },
    {
      "code": "invalid_numeric_values",
      "title": "数值列不可解析",
      "description": "log2FC 或 pvalue 存在非数字、空值或无限值，导致绘图失败。",
      "recoverable": true,
      "suggestedFix": "过滤无效行并提示用户确认阈值；如果有效行过少则中断并请求用户更换输入。",
      "detect": "invalid numeric values|non-numeric|nan|inf"
    },
    {
      "code": "empty_significant_set",
      "title": "没有满足阈值的显著基因",
      "description": "阈值过严或数据本身没有显著差异，图可生成但标注/分类结果可能为空。",
      "recoverable": true,
      "suggestedFix": "降低 fc_threshold 或 pval_threshold，并在报告中说明阈值变化。",
      "detect": "empty significant set|no significant genes|no rows meet threshold"
    }
  ],
  "estimatedMinutes": 2
}
