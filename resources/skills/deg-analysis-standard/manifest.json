{
  "skillManifestVersion": 1,
  "id": "deg-analysis-standard",
  "name": "标准差异表达分析",
  "version": "1.0.0",
  "description": "从原始计数矩阵到火山图的完整 DEG 分析流程。整合表达质控、DESeq2 差异分析和可视化，输出可发表级别的结果。",
  "category": "bioinformatics/ngs",
  "tags": ["deg", "rna-seq", "deseq2", "volcano", "differential-expression"],
  
  "source": "built-in",
  
  "capabilities": ["r-enrichment"],
  
  "plugins": {
    "required": ["expression-qc", "deseq2", "volcano-plot"],
    "optional": ["go-kegg", "gsea"]
  },
  
  "workflows": {
    "default": "deg-standard-pipeline",
    "variants": ["deg-quick", "deg-comprehensive"]
  },
  
  "prompts": {
    "system": "prompts/system.md",
    "user_templates": [
      "prompts/user/standard-deg.md"
    ]
  },
  
  "parameters": {
    "required": ["dataset", "group_column"],
    "optional": {
      "method": {
        "type": "select",
        "options": ["deseq2", "edger", "limma"],
        "default": "deseq2",
        "description": "差异分析方法"
      },
      "padj_threshold": {
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "description": "校正后 P 值阈值"
      },
      "logfc_threshold": {
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 10,
        "step": 0.5,
        "description": "Log2 Fold Change 阈值"
      },
      "species": {
        "type": "select",
        "options": ["human", "mouse", "rat", "zebrafish", "arabidopsis", "fruit-fly", "worm"],
        "default": "human",
        "description": "物种（影响 GO/KEGG 数据库选择）"
      },
      "shrinkage": {
        "type": "boolean",
        "default": true,
        "description": "是否使用 apeglm shrinkage（推荐开启）"
      },
      "filter_low_expression": {
        "type": "boolean",
        "default": true,
        "description": "是否过滤低表达基因"
      },
      "min_samples_per_group": {
        "type": "number",
        "default": 2,
        "min": 1,
        "max": 10,
        "description": "每组最小样本数"
      }
    }
  },
  
  "recovery_strategies": [
    {
      "when": "sample_group_mismatch",
      "description": "样本分组信息与计数矩阵不匹配",
      "do": "尝试自动检测分组列或请求用户确认",
      "fallback": "提供分组模板让用户填写",
      "recoverable": true
    },
    {
      "when": "insufficient_replicates",
      "description": "生物学重复数不足",
      "do": "警告用户并建议使用 limma-voom 方法，或降低统计检验严格度",
      "fallback": "使用 DESeq2 的 nbinomWaldTest",
      "recoverable": true
    },
    {
      "when": "low_gene_count",
      "description": "基因表达量过低",
      "do": "自动过滤低表达基因（保留 >10 counts 的基因）并重试",
      "fallback": "提示用户检查数据质量，可能需要过滤样本",
      "recoverable": true
    },
    {
      "when": "outlier_samples_detected",
      "description": "检测到异常样本",
      "do": "标记异常样本，询问用户是否排除后重试",
      "fallback": "继续分析但在报告中标注警告",
      "recoverable": true
    },
    {
      "when": "no_significant_deg",
      "description": "未发现显著差异基因",
      "do": "放宽阈值（padj 0.1）或提示用户检查数据生物学差异",
      "fallback": "生成空结果表并建议检查实验设计",
      "recoverable": true
    }
  ],
  
  "outputs": {
    "primary": [
      {
        "id": "volcano_plot",
        "type": "plot",
        "label": "火山图",
        "description": "差异基因可视化，展示 log2FC vs -log10(padj)",
        "format": "png",
        "dpi": 300
      },
      {
        "id": "degs_table",
        "type": "table",
        "label": "DEGs 结果表",
        "description": "所有差异表达基因详情，包含 gene、baseMean、log2FC、lfcSE、stat、pvalue、padj",
        "format": "csv",
        "columns": ["gene", "baseMean", "log2FC", "lfcSE", "stat", "pvalue", "padj", "significant"]
      },
      {
        "id": "qc_report",
        "type": "html",
        "label": "质控报告",
        "description": "表达量分布、样本相关性等质控图表"
      }
    ],
    "secondary": [
      {
        "id": "go_enrichment",
        "type": "table",
        "label": "GO 富集结果",
        "requires_plugin": "go-kegg",
        "description": "BP、CC、MF 三个 Ontology 的富集结果"
      },
      {
        "id": "kegg_pathway",
        "type": "plot",
        "label": "KEGG 通路图",
        "requires_plugin": "go-kegg",
        "description": "显著通路的 KEGG 可视化"
      },
      {
        "id": "heatmap",
        "type": "plot",
        "label": "差异基因热图",
        "description": "Top DEGs 的表达量热图"
      },
      {
        "id": "ma_plot",
        "type": "plot",
        "label": "MA 图",
        "description": "展示基因表达量与 fold change 的关系"
      }
    ]
  },
  
  "metadata": {
    "author": "BioF3 Team",
    "license": "MIT",
    "source": "built-in",
    "created": "2026-08-14",
    "updated": "2026-08-14",
    "compatibility": {
      "min_app_version": "0.1.0",
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "r_version": ">=4.4.0"
    }
  }
}
