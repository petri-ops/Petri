{
  "skillManifestVersion": 1,
  "id": "go-enrichment-analysis",
  "name": "GO 富集分析",
  "version": "1.0.0",
  "description": "对差异表达基因进行 Gene Ontology 富集分析，使用 clusterProfiler 进行统计检验和可视化，输出可发表级别的富集结果。",
  "category": "bioinformatics/ngs",
  "tags": ["go", "enrichment", "deg", "annotation", "clusterProfiler", "ontology"],
  "source": "built-in",
  "capabilities": ["r-enrichment"],
  "plugins": {
    "required": ["clusterProfiler"],
    "optional": ["enrichplot", "DOSE"]
  },
  "workflows": {
    "default": "go-enrichment-pipeline",
    "variants": ["go-bp-only", "go-comprehensive"]
  },
  "prompts": {
    "system": "prompts/system.md",
    "user_templates": [
      "prompts/user/standard-go.md"
    ]
  },
  "parameters": {
    "required": ["geneList"],
    "optional": {
      "organism": {
        "type": "select",
        "options": ["hsa", "mmu", "rno", "dre", "cel", "dme", "ath", "osa", "smm"],
        "default": "hsa",
        "description": "物种（hsa=人, mmu=小鼠, rno=大鼠, dre=斑马鱼, cel=线虫, dme=果蝇, ath=拟南芥, osa=水稻, smm=日本鹌鹑）"
      },
      "ontology": {
        "type": "select",
        "options": ["BP", "MF", "CC", "ALL"],
        "default": "ALL",
        "description": "GO Ontology（BP=生物学过程, MF=分子功能, CC=细胞组分, ALL=全部三类）"
      },
      "pvalueCutoff": {
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "description": "P-value 阈值"
      },
      "qvalueCutoff": {
        "type": "number",
        "default": 0.2,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "description": "Q-value（BH 校正）阈值"
      },
      "minGSSize": {
        "type": "number",
        "default": 10,
        "min": 1,
        "max": 500,
        "description": "每个通路最少基因数"
      },
      "maxGSSize": {
        "type": "number",
        "default": 500,
        "min": 1,
        "max": 5000,
        "description": "每个通路最多基因数"
      },
      "geneIDType": {
        "type": "select",
        "options": ["auto", "entrez", "symbol"],
        "default": "auto",
        "description": "基因 ID 类型（auto=自动检测, entrez=Entrez ID, symbol=基因符号）"
      }
    }
  },
  "recovery_strategies": [
    {
      "when": "invalid_gene_ids",
      "description": "基因 ID 格式无效或无法映射到 GO 数据库",
      "do": "尝试转换基因 ID 类型（symbol ↔ entrez）或提示用户确认输入格式",
      "fallback": "使用 geneIDType='auto' 自动检测并转换",
      "recoverable": true
    },
    {
      "when": "organism_not_supported",
      "description": "指定物种不在支持列表中",
      "do": "列出可用物种并请求用户选择",
      "fallback": "默认使用 hsa（人）",
      "recoverable": true
    },
    {
      "when": "no_significant_results",
      "description": "没有显著富集的通路",
      "do": "放宽阈值（pvalueCutoff 0.1, qvalueCutoff 0.3）并重试",
      "fallback": "生成空结果表并建议检查输入基因列表是否足够大",
      "recoverable": true
    },
    {
      "when": "gene_list_too_small",
      "description": "输入基因数量太少（<10）",
      "do": "警告用户并建议使用超几何检验的最小基因数",
      "fallback": "继续分析但降低 minGSSize 到 5",
      "recoverable": true
    },
    {
      "when": "gene_list_too_large",
      "description": "输入基因数量过多（>5000）",
      "do": "自动采样或提示用户分批分析",
      "fallback": "使用所有基因进行分析（可能较慢）",
      "recoverable": true
    }
  ],
  "outputs": {
    "primary": [
      {
        "id": "enrichment_table",
        "type": "table",
        "label": "GO 富集结果表",
        "description": "包含 GO ID、Description、Gene Ratio、P-value、q-value、Count、Gene ID 等列",
        "format": "csv",
        "columns": ["ONTOLOGY", "ID", "Description", "GeneRatio", "BgRatio", "pvalue", "p.adjust", "qvalue", "Count", "geneID"]
      },
      {
        "id": "dotplot",
        "type": "plot",
        "label": "富集气泡图",
        "description": "展示 Top 10 显著富集的 GO 通路",
        "format": "pdf",
        "dpi": 300
      }
    ],
    "secondary": [
      {
        "id": "barplot",
        "type": "plot",
        "label": "富集条形图",
        "requiresOntology": "BP",
        "requiresMinResults": 5,
        "description": "BP Ontology 的显著通路条形图"
      },
      {
        "id": "cnetplot",
        "type": "plot",
        "label": "富集网络图",
        "requiresGeneCount": 100,
        "description": "基因与通路的关系网络图（仅在基因数 ≤100 时生成）"
      },
      {
        "id": "goplot",
        "type": "plot",
        "label": "GO 有向无环图",
        "description": "展示 GO 层级结构的 DAG 图"
      },
      {
        "id": "analysis_report",
        "type": "markdown",
        "label": "分析报告",
        "description": "富集结果的解读和生物学意义说明"
      }
    ]
  },
  "metadata": {
    "author": "Petri Team",
    "license": "MIT",
    "source": "built-in",
    "created": "2026-08-14",
    "updated": "2026-08-14",
    "compatibility": {
      "min_app_version": "0.1.0",
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "r_version": ">=4.4.0"
    }
  }
}
