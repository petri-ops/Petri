# Backend Gateway Configuration

# Gateway Server
GATEWAY_PORT=3002

# Backend Services
R_SERVER_URL=http://127.0.0.1:3003
PY_SERVER_URL=http://127.0.0.1:3004

# Timeouts (milliseconds)
GATEWAY_TIMEOUT=300000

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=60000

# Pipeline Configuration
PIPELINE_STEP_TIMEOUT=300000      # 5 minutes per step
PIPELINE_GLOBAL_TIMEOUT=1800000   # 30 minutes total
PIPELINE_MAX_INLINE=10485760       # 10MB max inline data (files larger than this use temp files)
PIPELINE_TEMP_DIR=                # Optional: custom temp directory for pipeline artifacts
