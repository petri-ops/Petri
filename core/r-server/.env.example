# Copy to /etc/biof3.env on Dell (never commit secrets).
# deploy.sh --secrets syncs from local .biof3-secrets if configured.

JWT_SECRET=change-me-min-32-chars-random-string-here
INVITE_CODE=your-invite-code

# SQLite (current production default)
BIOF3_DB_PATH=/opt/biof3-r-server/biof3.db

# --- Phase B: PostgreSQL (not wired in db.js yet — see docs/ops/DATA_PLANE_POSTGRES_MIGRATION.md)
# DATABASE_URL=postgresql://biof3:PASSWORD@rds-host:5432/biof3
# BIOF3_DB_DRIVER=postgres

BIOF3_API_TOKEN=biof3-figcode-2026
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ============================================================
# Backend Gateway (Phase 2)
# ============================================================
# Gateway Server
GATEWAY_PORT=3002

# Backend Services URLs
# These must match the actual ports selected by src/main.js#selectBackendPorts
# (r=3001；python=3004/gateway=3005 已随 BLOCK-30 摘除). See §P1-CFG-1.
R_SERVER_URL=http://127.0.0.1:3001
PY_SERVER_URL=http://127.0.0.1:3004

# Tool Execution Timeout (ms)
GATEWAY_TIMEOUT=300000