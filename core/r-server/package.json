{
  "name": "biof3-r-server",
  "version": "1.0.0",
  "description": "Lightweight R execution server for BioF3 interactive tutorials",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:db-p0": "node --test ../test/db-pg-p0.mjs",
    "test:db-p1": "node --test ../test/db-pg-p1.mjs",
    "test:db-p2": "node --test ../test/db-pg-p2.mjs",
    "test:db-pg": "node --test ../test/db-pg-p0.mjs ../test/db-pg-p1.mjs ../test/db-pg-p2.mjs"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "deasync": "^0.1.30",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "uuid": "^9.0.0"
  }
}
