# ============================================================
# BioF3 Python Server — 环境变量配置
# ============================================================

# --- Server ---
PY_SERVER_PORT=3002
BIOF3_API_TOKEN=your-admin-api-token
NODE_ENV=production
LOG_LEVEL=info

# --- Paths ---
BIOF3_PY_TEMP_DIR=/mnt/storage_16tb/omichub/biof3-py-tmp
BIOF3_PY_DB_PATH=/opt/biof3-py-server/pyserver.db

# --- Docker Python Container ---
PY_CONTAINER=biof3_python_1
PY_CONTAINER_TEMP_DIR=/app/data/biof3-py-tmp

# --- Timeouts ---
PY_RUN_TIMEOUT_MS=30000
PY_TASK_TIMEOUT_MS=600000

# --- Concurrency ---
PY_MAX_CONCURRENT_TASKS=3
PY_POOL_SIZE=2
PY_POOL_ENABLED=true
PY_RATE_LIMIT=20

# --- OSS (shared with r-server) ---
OSS_AK=your_oss_access_key_id
OSS_SK=your_oss_access_key_secret
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=biof3-uploads
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# --- Upload ---
MAX_UPLOAD_SIZE=524288000

# --- Task Cleanup ---
TASK_RETENTION_MS=86400000
