{
  "name": "biof3-local",
  "version": "1.0.0",
  "private": true,
  "description": "BioF3 本地桌面版 — AI 陪伴的全组学学习与实战平台",
  "author": "BioF3",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --arm64 --x64",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:mac-x64": "electron-builder --mac --x64",
    "check": "node --check src/main.js && node --check src/preload.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "engines": {
    "node": ">=18.0"
  }
}
