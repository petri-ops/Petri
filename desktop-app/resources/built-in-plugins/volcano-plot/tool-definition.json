{
  "id": "volcano-plot",
  "title": "火山图绘制",
  "subtitle": "差异基因可视化",
  "category": "bulk RNA-seq",
  "language": "r",
  "description": "从差异分析结果绘制火山图",
  "inputs": [
    {
      "id": "deg_table",
      "label": "差异分析结果表 (CSV: gene, log2FC, pvalue)",
      "type": "file",
      "required": true,
      "accept": ".csv"
    },
    {
      "id": "fc_threshold",
      "label": "|log2FC| 阈值",
      "type": "number",
      "default": 1,
      "hint": "差异基因判定阈值，默认 1（即 2 倍变化）"
    },
    {
      "id": "pval_threshold",
      "label": "p value 阈值 (-log10)",
      "type": "number",
      "default": 1.3,
      "hint": "默认 1.3 即 p < 0.05"
    },
    {
      "id": "top_n",
      "label": "标注 top N 基因",
      "type": "number",
      "default": 10,
      "hint": "在图上标注变化最显著的 N 个基因名"
    }
  ],
  "outputs": [
    { "id": "volcano", "type": "plot", "label": "火山图" },
    { "id": "classified_table", "type": "table", "label": "分类结果表" }
  ],
  "estimatedMinutes": 2
}
