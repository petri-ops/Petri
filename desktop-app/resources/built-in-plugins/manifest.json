    "biof3-r-runtime": {
      "title": "R 运行时（基础环境）",
      "version": "1.0.0",
      "type": "runtime",
      "language": "r",
      "description": "R 4.5 + ggplot2/dplyr/data.table/BiocGenerics 等 70+ 包，BioF3 所有 R 工具的运行基础。约 280MB。",
      "url": "https://biof3-uploads.oss-cn-hangzhou.aliyuncs.com/plugins/r-runtime/1.0.0/macos-arm64.zip",
      "size": 280000000,
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "runtime": {
        "r": ">=4.4.0"
      }
    },
    "biof3-py-runtime": {
      "title": "Python 运行时（基础环境）",
      "version": "1.0.0",
      "type": "runtime",
      "language": "python",
      "description": "Python 3.11 + pandas/numpy/scipy/sklearn/matplotlib/scanpy 等 200+ 包，BioF3 所有 Python 工具的运行基础。约 750MB。",
      "url": "https://biof3-uploads.oss-cn-hangzhou.aliyuncs.com/plugins/py-runtime/1.0.0/macos-arm64.zip",
      "size": 750000000,
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "runtime": {
        "python": ">=3.10.0"
      }
    },
    "volcano-plot": {
      "title": "火山图绘制",
      "version": "1.0.0",
      "language": "r",
      "description": "从差异分析结果（log2FC + pvalue）绘制 publication-ready 火山图，支持阈值标注与 top 基因高亮。",
      "url": "built-in://volcano-plot",
      "size": 0,
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "packages": {
        "r": {
          "ggplot2": ">=3.4.0",
          "ggrepel": ">=0.9.0"
        }
      },
      "runtime": {
        "r": ">=4.3.0"
      }
    },
    "gene-correlation": {
      "title": "基因相关性热图",
      "version": "1.0.0",
      "language": "r",
      "description": "计算表达矩阵中 top N 基因的 Pearson/Spearman 相关系数，输出相关性热图 + 系数矩阵 CSV。",
      "url": "built-in://gene-correlation",
      "size": 0,
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "packages": {
        "r": {
          "ggplot2": ">=3.4.0",
          "pheatmap": ">=1.0.12"
        }
      },
      "runtime": {
        "r": ">=4.3.0"
      }
    },
    "pca-explorer": {
      "title": "PCA 可视化",
      "version": "1.0.0",
      "language": "python",
      "description": "对表达矩阵做 PCA 降维，输出 PC1/PC2 散点图（按分组着色）+ 方差贡献表。",
      "url": "built-in://pca-explorer",
      "size": 0,
      "platform": ["macos-arm64", "macos-x64", "windows-x64"],
      "packages": {
        "python": {
          "pandas": ">=2.0.0",
          "scikit-learn": ">=1.3.0",
          "matplotlib": ">=3.7.0"
        }
      },
      "runtime": {
        "python": ">=3.10.0"
      }
    },
    "figcode-r-extra": {
