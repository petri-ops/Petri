{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.js",
    "src/preload.js",
    "frontend/src/main.tsx",
    "frontend/src/App.tsx",
    "test/**/*.test.{mjs,cjs}",
    "scripts/**/*.mjs",
    "scripts/*.cjs",
    "core/petri-server/agent-tools/plugin-loader.js",
    "core/petri-server/agent-tools/learning.js",
    "core/petri-server/mcp/registry/run-plugin-script.js",
    ".agents/skills/petri-dev-infra/dev-verify/flows/ui-d2-geometry-live.cjs",
    ".agents/skills/petri-dev-infra/dev-verify/flows/ui-d4-a11y-live.cjs"
  ],
  "project": [
    "src/**/*.js",
    "core/**/*.js",
    "frontend/src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,cjs}"
  ],
  "ignore": [
    "core/petri-server/build/**",
    "**/__fixtures__/**"
  ],
  "ignoreBinaries": [
    "gitleaks"
  ],
  "ignoreDependencies": [
    "typescript",
    "@types/react",
    "@types/react-dom",
    "electron",
    "react",
    "react-dom"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/main.js",
        "src/preload.js",
        "core/**/*.js",
        "scripts/**/*.{js,mjs,cjs}",
        "test/**/*.{mjs,cjs,js}",
        "build/**/*.js",
        ".agents/skills/petri-dev-infra/dev-verify/flows/ui-d2-geometry-live.cjs",
        ".agents/skills/petri-dev-infra/dev-verify/flows/ui-d4-a11y-live.cjs"
      ]
    },
    "frontend": {
      "entry": [
        "frontend/src/main.tsx",
        "frontend/src/App.tsx",
        "frontend/src/**/*.test.{ts,tsx}"
      ]
    }
  }
}
