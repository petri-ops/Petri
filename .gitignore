# Dependencies
node_modules/
.biof3-dev-user-data/

# Build output
dist/
build/

# 运行时制品构建产物（build-win-*-runtime-artifact.mjs 输出目录，
# 含数百 MB R/Python 树 + 临时探针 zip，绝不该进仓库）
dist-runtime/

# Electron packaging output
release/
out/

# Cache
.cache/
.vite/

# TypeScript incremental build cache (tsc -b)
*.tsbuildinfo
tsconfig.tsbuildinfo

# Misc
.DS_Store
*.log
.env
.env.local
.biof3-secrets

# IDE
.vscode/
.idea/

# Local aionui CLI symlink (points to ~/.aionui/builtin-skills/...)
.aionrs/

# Local scratch / agent working area
tmp/

# Harness provider-eval reports (real-network manual run; may reference model
# behavior, kept local — the eval script and its unit tests are committed)
eval-reports/

# Cursor IDE local settings (machine-local)
.cursor/

# Kiro local agent hooks/settings (machine-local, not shared)
.kiro/

# Absorbed core (formerly vendor/biof3-core submodule) — runtime/generated files.
# node_modules/ and *.log are already ignored globally above; these are the
# core-specific dev databases, caches, backups, and large demo datasets.
core/r-server/biof3.db*
core/r-server/.tmp/
core/r-server/backups/
core/py-server/pyserver.db*
core/**/__pycache__/
core/**/*.pyc
core/r-server/tool-demo-data/
core/r-server/tool-demo-results/
core/**/.DS_Store

# WorkBuddy agent 工作区记忆（本地工具产物，非项目源码）
.workbuddy/
